Thumbs.db

# 파이썬
__pycache__/
*.pyc

# PDF 빌드·시각 검수 중간 산출물
tmp/
tmp/pdfs/

# 제출 폴더에서 정리한 이전 이미지·영상·소재의 로컬 보관본
